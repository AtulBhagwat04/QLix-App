PORT=3000
NODE_ENV=development

# Database Configuration (Required: MongoDB Atlas connection URI or local MongoDB)
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/qlix_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/qlix_db

# Redis Cache & Scaling Configuration (Optional: automatically falls back to in-memory store if omitted or unreachable)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate secure random strings for production)
JWT_SECRET=supersecretjwtkeyforqlixauth
JWT_REFRESH_SECRET=supersecretjwtrefreshkeyforqlixauth

